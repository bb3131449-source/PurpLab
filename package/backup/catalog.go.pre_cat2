package main

import (
	"fmt"
	"io"
	"net/http"
	"os"
	"path/filepath"
	"strconv"
	"strings"
	"time"
)

type Repo struct {
	Name string
	URL  string
}

const (
	httpUA       = "purpnet/1"
	maxToolBytes = 1 << 20
	httpTimeout  = 10 * time.Second
)

var httpClient = &http.Client{Timeout: httpTimeout}
var repos []Repo

func purpRoot() string {
	home, err := os.UserHomeDir()
	if err != nil {
		return ""
	}
	return filepath.Join(home, "PurpNet")
}

func reposPath() string {
	root := purpRoot()
	if root == "" {
		return ""
	}
	return filepath.Join(root, "repos.toml")
}

func cacheRoot() string {
	root := purpRoot()
	if root == "" {
		return ""
	}
	return filepath.Join(root, "cache")
}

func repoCacheDir(repo Repo) string {
	root := cacheRoot()
	if root == "" {
		return ""
	}
	return filepath.Join(root, safeName(repo.Name))
}

func safeName(s string) string {
	var b strings.Builder
	for _, r := range s {
		switch {
		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_':
			b.WriteRune(r)
		case r == ' ':
			b.WriteRune('_')
		}
	}
	if b.Len() == 0 {
		return "repo"
	}
	return b.String()
}

func validID(id string) bool {
	if id == "" || id == "." || id == ".." {
		return false
	}
	for _, r := range id {
		switch {
		case r >= 'a' && r <= 'z', r >= 'A' && r <= 'Z', r >= '0' && r <= '9', r == '-', r == '_':
		default:
			return false
		}
	}
	return true
}

func LoadRepos() []Repo {
	path := reposPath()
	if path == "" {
		return nil
	}
	data, err := os.ReadFile(path)
	if err != nil {
		return nil
	}
	var out []Repo
	var cur *Repo
	flush := func() {
		if cur != nil && (cur.Name != "" || cur.URL != "") {
			if cur.Name == "" {
				cur.Name = cur.URL
			}
			out = append(out, *cur)
		}
		cur = nil
	}
	for _, line := range strings.Split(string(data), "\n") {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if line == "[[repo]]" {
			flush()
			cur = &Repo{}
			continue
		}
		if cur == nil {
			continue
		}
		k, v, ok := strings.Cut(line, "=")
		if !ok {
			continue
		}
		v = strings.Trim(strings.TrimSpace(v), `"'`)
		switch strings.TrimSpace(k) {
		case "name":
			cur.Name = v
		case "url":
			cur.URL = v
		}
	}
	flush()
	return out
}

func httpGet(url string) ([]byte, error) {
	req, err := http.NewRequest("GET", url, nil)
	if err != nil {
		return nil, err
	}
	req.Header.Set("User-Agent", httpUA)
	resp, err := httpClient.Do(req)
	if err != nil {
		return nil, err
	}
	defer resp.Body.Close()
	if resp.StatusCode != http.StatusOK {
		return nil, fmt.Errorf("HTTP %d", resp.StatusCode)
	}
	data, err := io.ReadAll(io.LimitReader(resp.Body, maxToolBytes+1))
	if err != nil {
		return nil, err
	}
	if len(data) > maxToolBytes {
		return nil, fmt.Errorf("file too large (>%d bytes)", maxToolBytes)
	}
	return data, nil
}

func manifestURL(repo Repo) string {
	return strings.TrimRight(repo.URL, "/") + "/manifest.txt"
}

func fetchManifest(repo Repo) ([]string, error) {
	data, err := httpGet(manifestURL(repo))
	if err != nil {
		return nil, err
	}
	var ids []string
	seen := map[string]bool{}
	for _, line := range strings.Split(string(data), "\n") {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if !validID(line) {
			continue
		}
		if seen[line] {
			continue
		}
		seen[line] = true
		ids = append(ids, line)
	}
	return ids, nil
}

var (
	curRepo   int
	curTool   int
	catItems  []string
	catLoaded bool
	catErr    string
)

func InitCatalog() {
	repos = LoadRepos()
	curRepo = 0
	curTool = 0
	catItems = nil
	catLoaded = false
	catErr = ""
}

func reloadCatalog() {
	repos = LoadRepos()
	if curRepo >= len(repos) {
		curRepo = max(0, len(repos)-1)
	}
	catLoaded = false
	if reposSel > len(repos) {
		reposSel = len(repos)
	}
}

func refreshTools() {
	catItems = nil
	catErr = ""
	catLoaded = true
	if len(repos) == 0 || curRepo < 0 || curRepo >= len(repos) {
		return
	}
	ids, err := fetchManifest(repos[curRepo])
	if err != nil {
		catErr = err.Error()
		return
	}
	catItems = ids
}

func ensureLoaded() {
	if !catLoaded {
		refreshTools()
		catLoaded = true
	}
}

func writeColored(b []byte, s string, col RGB) []byte {
	b = appendFG(b, col)
	return append(b, s...)
}

func RenderCatalog(b []byte, baseY int) []byte {
	ensureLoaded()
	y := baseY

	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	if len(repos) == 0 {
		b = writeColored(b, "(no repos)", theme.HintSep)
		b = append(b, "\x1b[m\x1b[K"...)
		return b
	}
	for i, r := range repos {
		if i > 0 {
			b = writeColored(b, " • ", theme.HintSep)
		}
		if i == curRepo {
			b = writeColored(b, r.Name, theme.White)
		} else {
			b = writeColored(b, r.Name, theme.TitleStart)
		}
	}
	b = append(b, "\x1b[m\x1b[K"...)
	y++

	b = fmt.Appendf(b, "\x1b[%d;1H\x1b[K", y)
	y++

	if catErr != "" {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
		b = writeColored(b, "(fetch failed: "+catErr+")", theme.HintSep)
		b = append(b, "\x1b[m\x1b[K"...)
		return b
	}
	if len(catItems) == 0 {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
		b = writeColored(b, "(no tools)", theme.HintSep)
		b = append(b, "\x1b[m\x1b[K"...)
		return b
	}

	numW := max(2, len(strconv.Itoa(len(catItems))))
	for i, id := range catItems {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y+i)
		num := fmt.Sprintf("%0*d", numW, i+1)
		if i == curTool {
			b = writeColored(b, num+" "+id, theme.White)
		} else {
			b = writeColored(b, num, theme.NumberColor)
			b = append(b, ' ')
			b = writeColored(b, id, theme.TitleStart)
		}
		b = append(b, "\x1b[m\x1b[K"...)
	}
	return b
}

func HandleCatalogKey(code int) (consumed bool, newMode int) {
	switch code {
	case keyEsc:
		return true, modeSystem
	case keyLeft:
		if len(repos) > 0 {
			curRepo = (curRepo - 1 + len(repos)) % len(repos)
			curTool = 0
			refreshTools()
		}
		return true, modeCatalog
	case keyRight:
		if len(repos) > 0 {
			curRepo = (curRepo + 1) % len(repos)
			curTool = 0
			refreshTools()
		}
		return true, modeCatalog
	case keyDown:
		if len(catItems) > 0 {
			curTool = min(curTool+1, len(catItems)-1)
		}
		return true, modeCatalog
	case keyUp:
		if len(catItems) > 0 {
			curTool = max(curTool-1, 0)
		}
		return true, modeCatalog
	case keyEnter:
		if len(catItems) > 0 && curTool >= 0 && curTool < len(catItems) {
			cardErr = ""
			return true, modeCard
		}
		return true, modeCatalog
	case keyR:
		reposSel = 0
		return true, modeRepos
	}
	return false, 0
}

// cardErr — last error shown on card (empty if ok).
var cardErr string

func setCardErr(s string) { cardErr = s }

func cardLines() int { return 3 }

// HandleCardKey handles keys in modeCard. run=true means "download + run now".
func HandleCardKey(code int) (consumed bool, newMode int, run bool) {
	switch code {
	case keyEsc:
		cardErr = ""
		return true, modeCatalog, false
	case keyEnter:
		if curTool >= 0 && curTool < len(catItems) {
			return true, modeCard, true
		}
		return true, modeCard, false
	}
	return false, 0, false
}

// getCurrentTool downloads (if needed) and returns Tool for current selection.
func getCurrentTool() (Tool, error) {
	if len(repos) == 0 {
		return Tool{}, fmt.Errorf("no repos")
	}
	if curRepo < 0 || curRepo >= len(repos) {
		return Tool{}, fmt.Errorf("invalid repo")
	}
	if curTool < 0 || curTool >= len(catItems) {
		return Tool{}, fmt.Errorf("no tool selected")
	}
	id := catItems[curTool]
	path, err := downloadTool(repos[curRepo], id)
	if err != nil {
		return Tool{}, fmt.Errorf("download: %v", err)
	}
	t, err := parseToolMeta(path)
	if err != nil {
		return Tool{}, fmt.Errorf("parse: %v", err)
	}
	t.ID = id
	t.Path = path
	if t.Name == "" {
		t.Name = id
	}
	return t, nil
}

// RenderCard draws tool detail below frame: name / version•author / desc.
func RenderCard(b []byte, baseY int) []byte {
	if curTool < 0 || curTool >= len(catItems) {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", baseY)
		b = writeColored(b, "(no tool selected)", theme.HintSep)
		b = append(b, "\x1b[m\x1b[K"...)
		return b
	}
	id := catItems[curTool]
	name := id
	meta := ""
	desc := ""
	if len(repos) > 0 && curRepo >= 0 && curRepo < len(repos) {
		path := filepath.Join(repoCacheDir(repos[curRepo]), id+".go")
		if _, err := os.Stat(path); err == nil {
			if t, err := parseToolMeta(path); err == nil {
				if t.Name != "" {
					name = t.Name
				}
				var parts []string
				if t.Version != "" {
					parts = append(parts, t.Version)
				}
				if t.Author != "" {
					parts = append(parts, "by "+t.Author)
				}
				meta = joinDot(parts)
				desc = t.Desc
			}
		} else {
			meta = "(not cached — ↵ downloads and runs)"
		}
	}

	y := baseY
	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	b = writeColored(b, cleanName(name), theme.White)
	b = append(b, "\x1b[m\x1b[K"...)
	y++

	if meta != "" {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
		b = writeColored(b, cleanName(meta), theme.TitleStart)
		b = append(b, "\x1b[m\x1b[K"...)
	}
	y++

	if desc != "" {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
		b = writeColored(b, cleanName(desc), theme.HintLabel)
		b = append(b, "\x1b[m\x1b[K"...)
	} else if cardErr != "" {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
		b = writeColored(b, "error: "+cleanName(cardErr), theme.HintSep)
		b = append(b, "\x1b[m\x1b[K"...)
	}
	return b
}

func joinDot(parts []string) string {
	out := ""
	for i, p := range parts {
		if i > 0 {
			out += " • "
		}
		out += p
	}
	return out
}

// HintCard returns the hint for modeCard.
func HintCard() []hintSeg {
	return []hintSeg{
		{"↵", "Run"},
		{"Esc", "Back"},
		{"q", "Quit"},
	}
}

func HintCatalog() []hintSeg {
	return []hintSeg{
		{"⇅⇄", "Navigation"},
		{"↵", "Open"},
		{"r", "Repos"},
		{"Esc", "Back"},
		{"q", "Quit"},
	}
}


// ─── Restored functions ───

func toolURL(repo Repo, id string) string {
	return strings.TrimRight(repo.URL, "/") + "/" + id + ".go"
}

func fetchTool(repo Repo, id string) ([]byte, error) {
	if !validID(id) {
		return nil, fmt.Errorf("invalid id: %q", id)
	}
	return httpGet(toolURL(repo, id))
}

func downloadTool(repo Repo, id string) (string, error) {
	if !validID(id) {
		return "", fmt.Errorf("invalid id: %q", id)
	}
	dir := repoCacheDir(repo)
	if dir == "" {
		return "", fmt.Errorf("cache dir not available")
	}
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return "", err
	}
	path := filepath.Join(dir, id+".go")
	if st, err := os.Stat(path); err == nil && st.Mode().IsRegular() {
		return path, nil
	}
	data, err := fetchTool(repo, id)
	if err != nil {
		return "", err
	}
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, data, 0o644); err != nil {
		return "", err
	}
	return path, os.Rename(tmp, path)
}

func forceDownload(repo Repo, id string) (string, error) {
	dir := repoCacheDir(repo)
	if dir == "" {
		return "", fmt.Errorf("cache dir not available")
	}
	if err := os.MkdirAll(dir, 0o755); err != nil {
		return "", err
	}
	data, err := fetchTool(repo, id)
	if err != nil {
		return "", err
	}
	path := filepath.Join(dir, id+".go")
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, data, 0o644); err != nil {
		return "", err
	}
	return path, os.Rename(tmp, path)
}

func purgeRepoCache(repo Repo) error {
	dir := repoCacheDir(repo)
	if dir == "" {
		return nil
	}
	return os.RemoveAll(dir)
}

// ═══════════════════════════════════════════════════════════════
// Repos management UI (add/remove/edit)
// ═══════════════════════════════════════════════════════════════

var reposSel int

type repoForm struct {
	name, url       []rune
	namePos, urlPos int
	field           int
	editIdx         int // -1 = new
}

var form repoForm

const (
	formName   = 0
	formURL    = 1
	formSave   = 2
	formDelete = 3
	formCancel = 4
)

func (f *repoForm) skipField() bool { return f.editIdx < 0 && f.field == formDelete }

func (f *repoForm) nextField() {
	f.field++
	if f.field > formCancel { f.field = 0 }
	if f.skipField() { f.field++ }
	if f.field > formCancel { f.field = 0 }
}

func (f *repoForm) prevField() {
	f.field--
	if f.field < 0 { f.field = formCancel }
	if f.skipField() { f.field-- }
	if f.field < 0 { f.field = formCancel }
}

func startFormNew() { form = repoForm{field: formName, editIdx: -1} }

func startFormEdit(idx int) {
	if idx < 0 || idx >= len(repos) { return }
	r := repos[idx]
	form = repoForm{
		name: []rune(r.Name), url: []rune(r.URL),
		namePos: len([]rune(r.Name)), urlPos: len([]rune(r.URL)),
		field: formName, editIdx: idx,
	}
}

func applyForm() {
	name := string(form.name)
	url := string(form.url)
	if url == "" { return }
	if name == "" { name = url }
	nr := Repo{Name: name, URL: url}
	if form.editIdx >= 0 && form.editIdx < len(repos) {
		repos[form.editIdx] = nr
	} else {
		repos = append(repos, nr)
	}
	SaveRepos(repos)
	reloadCatalog()
}

func deleteRepo(idx int) {
	if idx < 0 || idx >= len(repos) { return }
	purgeRepoCache(repos[idx])
	repos = append(repos[:idx], repos[idx+1:]...)
	if reposSel > len(repos) { reposSel = len(repos) }
	SaveRepos(repos)
	reloadCatalog()
}

func insertRune(s []rune, pos int, r rune) []rune {
	if pos < 0 { pos = 0 }
	if pos > len(s) { pos = len(s) }
	out := make([]rune, len(s)+1)
	copy(out, s[:pos])
	out[pos] = r
	copy(out[pos+1:], s[pos:])
	return out
}

func deleteRune(s []rune, pos int) []rune {
	if pos <= 0 || pos > len(s) { return s }
	out := make([]rune, len(s)-1)
	copy(out, s[:pos-1])
	copy(out[pos-1:], s[pos:])
	return out
}

func HandleReposKey(code int) (consumed bool, newMode int) {
	switch code {
	case keyEsc:
		return true, modeCatalog
	case keyUp:
		if reposSel > 0 { reposSel-- }
		return true, modeRepos
	case keyDown:
		if reposSel < len(repos) { reposSel++ }
		return true, modeRepos
	case keyEnter:
		if reposSel == 0 {
			startFormNew()
			return true, modeRepoForm
		}
		startFormEdit(reposSel - 1)
		return true, modeRepoForm
	case keyLeft, keyRight:
		return true, modeRepos
	}
	return false, 0
}

func HandleRepoFormKey(code int) (consumed bool, newMode int) {
	f := &form
	switch code {
	case keyEsc:
		return true, modeRepos
	case keyTab:
		f.nextField()
		return true, modeRepoForm
	case keyBackTab:
		f.prevField()
		return true, modeRepoForm
	case keyLeft:
		if f.field == formName && f.namePos > 0 { f.namePos-- }
		if f.field == formURL && f.urlPos > 0 { f.urlPos-- }
		return true, modeRepoForm
	case keyRight:
		if f.field == formName && f.namePos < len(f.name) { f.namePos++ }
		if f.field == formURL && f.urlPos < len(f.url) { f.urlPos++ }
		return true, modeRepoForm
	case keyBackspace:
		if f.field == formName && f.namePos > 0 {
			f.name = deleteRune(f.name, f.namePos)
			f.namePos--
		}
		if f.field == formURL && f.urlPos > 0 {
			f.url = deleteRune(f.url, f.urlPos)
			f.urlPos--
		}
		return true, modeRepoForm
	case keyEnter:
		switch f.field {
		case formSave:
			applyForm()
			return true, modeRepos
		case formCancel:
			return true, modeRepos
		case formDelete:
			if f.editIdx >= 0 {
				deleteRepo(f.editIdx)
				return true, modeRepos
			}
			return true, modeRepoForm
		default:
			f.nextField()
			return true, modeRepoForm
		}
	case keyUp, keyDown:
		return true, modeRepoForm
	}
	if code >= 32 && code < 127 {
		switch f.field {
		case formName:
			f.name = insertRune(f.name, f.namePos, rune(code))
			f.namePos++
		case formURL:
			f.url = insertRune(f.url, f.urlPos, rune(code))
			f.urlPos++
		}
		return true, modeRepoForm
	}
	return false, 0
}

func reposLines() int {
	if len(repos) == 0 { return 2 }
	return 1 + len(repos)
}

func formLines() int { return 7 }

func RenderRepos(b []byte, baseY int) []byte {
	y := baseY
	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	if reposSel == 0 {
		b = writeColored(b, "+ Add new", theme.White)
	} else {
		b = writeColored(b, "+ Add new", theme.TitleStart)
	}
	b = append(b, "\x1b[m\x1b[K"...)
	y++

	if len(repos) == 0 {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
		b = writeColored(b, "(no repos — press Enter on + Add new)", theme.HintSep)
		b = append(b, "\x1b[m\x1b[K"...)
		return b
	}
	for i, r := range repos {
		b = fmt.Appendf(b, "\x1b[%d;1H  ", y+i)
		num := fmt.Sprintf("%02d", i+1)
		name := cleanName(r.Name)
		if reposSel == i+1 {
			b = writeColored(b, num+" "+name, theme.White)
		} else {
			b = writeColored(b, num, theme.NumberColor)
			b = append(b, ' ')
			b = writeColored(b, name, theme.TitleStart)
		}
		b = append(b, "\x1b[m\x1b[K"...)
	}
	return b
}

func renderField(b []byte, chars []rune, pos int, active bool, width int) []byte {
	valCol := theme.TitleStart
	if active { valCol = theme.White }
	b = writeColored(b, "[", theme.HintSep)
	for i := 0; i < width; i++ {
		var ch rune = ' '
		if i < len(chars) {
			ch = chars[i]
			if ch < 32 || ch > 126 { ch = '?' }
		}
		isCursor := active && i == pos
		if isCursor {
			if ch == ' ' {
				b = writeColored(b, "_", theme.White)
			} else {
				b = writeColored(b, string(ch), theme.White)
			}
		} else {
			b = writeColored(b, string(ch), valCol)
		}
	}
	b = writeColored(b, "]", theme.HintSep)
	return b
}

func RenderForm(b []byte, baseY int) []byte {
	y := baseY
	w := 40
	if termCols > 0 && termCols < 48 {
		w = termCols - 10
		if w < 20 { w = 20 }
	}

	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	b = writeColored(b, "Name:", theme.HintLabel)
	b = append(b, "\x1b[m\x1b[K"...)
	y++
	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	b = renderField(b, form.name, form.namePos, form.field == formName, w)
	b = append(b, "\x1b[m\x1b[K"...)
	y += 2

	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	b = writeColored(b, "URL:", theme.HintLabel)
	b = append(b, "\x1b[m\x1b[K"...)
	y++
	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	b = renderField(b, form.url, form.urlPos, form.field == formURL, w)
	b = append(b, "\x1b[m\x1b[K"...)
	y += 2

	b = fmt.Appendf(b, "\x1b[%d;1H  ", y)
	saveCol := theme.TitleStart
	if form.field == formSave { saveCol = theme.White }
	b = writeColored(b, "[Save]", saveCol)
	b = append(b, ' ')
	if form.editIdx >= 0 {
		delCol := theme.TitleStart
		if form.field == formDelete { delCol = theme.White }
		b = writeColored(b, "[Delete]", delCol)
		b = append(b, ' ')
	}
	canCol := theme.TitleStart
	if form.field == formCancel { canCol = theme.White }
	b = writeColored(b, "[Cancel]", canCol)
	b = append(b, "\x1b[m\x1b[K"...)
	return b
}

func HintRepos() []hintSeg {
	return []hintSeg{
		{"⇅", "Navigation"},
		{"↵", "Open"},
		{"Esc", "Back"},
		{"q", "Quit"},
	}
}

func HintRepoForm() []hintSeg {
	return []hintSeg{
		{"Tab", "Field"},
		{"↵", "Confirm"},
		{"Esc", "Cancel"},
	}
}

// SaveRepos writes repos to ~/PurpNet/repos.toml atomically.
func SaveRepos(list []Repo) error {
	path := reposPath()
	if path == "" {
		return fmt.Errorf("home dir not found")
	}
	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
		return err
	}
	var b strings.Builder
	b.WriteString("# PurpNet repos\n")
	b.WriteString("# [[repo]]\n# name = \"...\"\n# url  = \"...\"\n")
	for _, r := range list {
		b.WriteString("\n[[repo]]\n")
		b.WriteString("name = ")
		b.WriteString(quoteTOML(r.Name))
		b.WriteString("\nurl  = ")
		b.WriteString(quoteTOML(r.URL))
		b.WriteString("\n")
	}
	tmp := path + ".tmp"
	if err := os.WriteFile(tmp, []byte(b.String()), 0o644); err != nil {
		return err
	}
	return os.Rename(tmp, path)
}

func quoteTOML(s string) string {
	var b strings.Builder
	b.WriteByte('"')
	for _, r := range s {
		switch r {
		case '"', '\\':
			b.WriteByte('\\')
			b.WriteRune(r)
		case '\n':
			b.WriteString("\\n")
		default:
			b.WriteRune(r)
		}
	}
	b.WriteByte('"')
	return b.String()
}
