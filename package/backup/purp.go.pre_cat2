// ─────────────────────── ThemeColors ───────────────────────

type ThemeColors struct {
	White       RGB
	TitleDark   RGB
	FrameBorder RGB
	NumberColor RGB
	LogoStart   RGB
	LogoEnd     RGB
	TitleStart  RGB
	TitleEnd    RGB
	BannerStart RGB
	BannerMid   RGB
	BannerEnd   RGB
	HintKey     RGB
	HintLabel   RGB
	HintSep     RGB
	GlowTint    float64

	StatusInterrupted int
	StatusBuildFailed int
	StatusExitFailed  int
	StatusSuccess     int
	StatusBuilding    int
}

func defaultTheme() ThemeColors {
	return ThemeColors{
		White:             RGB{255, 255, 255},
		TitleDark:         RGB{14, 12, 20},
		FrameBorder:       RGB{200, 200, 220},
		NumberColor:       RGB{205, 210, 220},
		LogoStart:         RGB{225, 225, 225},
		LogoEnd:           RGB{140, 140, 140},
		TitleStart:        RGB{170, 170, 255},
		TitleEnd:          RGB{138, 112, 238},
		BannerStart:       RGB{228, 218, 255},
		BannerMid:         RGB{170, 170, 255},
		BannerEnd:         RGB{138, 112, 238},
		HintKey:           RGB{210, 214, 224},
		HintLabel:         RGB{210, 214, 224},
		HintSep:           RGB{120, 124, 138},
		GlowTint:          0.3,
		StatusInterrupted: 33,
		StatusBuildFailed: 31,
		StatusExitFailed:  31,
		StatusSuccess:     32,
		StatusBuilding:    2,
	}
}

func colorsPath() string {
	home, err := os.UserHomeDir()
	if err != nil {
		return ""
	}
	return filepath.Join(home, "PurpNet", "colors.toml")
}

var theme = loadColors()

var (
	ansiStatusInterrupted = theme.StatusInterrupted
	ansiStatusBuildFailed = theme.StatusBuildFailed
	ansiStatusExitFailed  = theme.StatusExitFailed
	ansiStatusSuccess     = theme.StatusSuccess
	ansiStatusBuilding    = theme.StatusBuilding
)

func loadColors() ThemeColors {
	t := defaultTheme()
	path := colorsPath()
	if path == "" {
		return t
	}
	data, err := os.ReadFile(path)
	if err != nil {
		return t
	}
	section := ""
	for _, line := range strings.Split(string(data), "\n") {
		line = strings.TrimSpace(line)
		if line == "" || strings.HasPrefix(line, "#") {
			continue
		}
		if strings.HasPrefix(line, "[") && strings.HasSuffix(line, "]") {
			section = strings.TrimSpace(line[1 : len(line)-1])
			continue
		}
		k, v, ok := strings.Cut(line, "=")
		if !ok {
			continue
		}
		applyColor(&t, section, strings.TrimSpace(k), strings.TrimSpace(v))
	}
	return t
}

func parseRGB(s string) (RGB, bool) {
	s = strings.TrimSpace(s)
	if !strings.HasPrefix(s, "[") || !strings.HasSuffix(s, "]") {
		return RGB{}, false
	}
	parts := strings.Split(s[1:len(s)-1], ",")
	if len(parts) != 3 {
		return RGB{}, false
	}
	var c RGB
	for i, p := range parts {
		n, err := strconv.Atoi(strings.TrimSpace(p))
		if err != nil {
			return RGB{}, false
		}
		c[i] = max(0, min(255, n))
	}
	return c, true
}

func ansiCode(name string) int {
	switch strings.ToLower(name) {
	case "black":
		return 30
	case "red":
		return 31
	case "green":
		return 32
	case "yellow":
		return 33
	case "blue":
		return 34
	case "magenta":
		return 35
	case "cyan":
		return 36
	case "white":
		return 37
	case "bright_black":
		return 90
	case "bright_red":
		return 91
	case "bright_green":
		return 92
	case "bright_yellow":
		return 93
	case "bright_blue":
		return 94
	case "bright_magenta":
		return 95
	case "bright_cyan":
		return 96
	case "bright_white":
		return 97
	case "dim":
		return 2
	case "bold":
		return 1
	case "reset":
		return 0
	}
	return 0
}

func applyColor(t *ThemeColors, section, key, val string) {
	switch section {
	case "base":
		switch key {
		case "white":
			if c, ok := parseRGB(val); ok {
				t.White = c
			}
		case "title_dark":
			if c, ok := parseRGB(val); ok {
				t.TitleDark = c
			}
		}
	case "frame":
		if key == "border" {
			if c, ok := parseRGB(val); ok {
				t.FrameBorder = c
			}
		}
	case "numbers":
		if key == "fg" {
			if c, ok := parseRGB(val); ok {
				t.NumberColor = c
			}
		}
	case "logo":
		switch key {
		case "start":
			if c, ok := parseRGB(val); ok {
				t.LogoStart = c
			}
		case "end":
			if c, ok := parseRGB(val); ok {
				t.LogoEnd = c
			}
		}
	case "title":
		switch key {
		case "start":
			if c, ok := parseRGB(val); ok {
				t.TitleStart = c
			}
		case "end":
			if c, ok := parseRGB(val); ok {
				t.TitleEnd = c
			}
		}
	case "banner":
		switch key {
		case "start":
			if c, ok := parseRGB(val); ok {
				t.BannerStart = c
			}
		case "mid":
			if c, ok := parseRGB(val); ok {
				t.BannerMid = c
			}
		case "end":
			if c, ok := parseRGB(val); ok {
				t.BannerEnd = c
			}
		}
	case "hint":
		switch key {
		case "key":
			if c, ok := parseRGB(val); ok {
				t.HintKey = c
			}
		case "label":
			if c, ok := parseRGB(val); ok {
				t.HintLabel = c
			}
		case "sep":
			if c, ok := parseRGB(val); ok {
				t.HintSep = c
			}
		}
	case "glow":
		if key == "tint" {
			if f, err := strconv.ParseFloat(val, 64); err == nil {
				t.GlowTint = max(0, min(1, f))
			}
		}
	case "status":
		code := ansiCode(strings.Trim(val, `"'`))
		if code == 0 {
			return
		}
		switch key {
		case "interrupted":
			t.StatusInterrupted = code
		case "build_failed":
			t.StatusBuildFailed = code
		case "exit_failed":
			t.StatusExitFailed = code
		case "success":
			t.StatusSuccess = code
		case "building":
			t.StatusBuilding = code
		}
	}
}

func writeDefaultColors() error {
	t := defaultTheme()
	path := colorsPath()
	if path == "" {
		return fmt.Errorf("home dir not found")
	}
	if err := os.MkdirAll(filepath.Dir(path), 0o755); err != nil {
		return err
	}
	if _, err := os.Stat(path); err == nil {
		os.Rename(path, path+".bak")
	}
	body := fmt.Sprintf(`# PurpNet colors
# Colors: [R, G, B], 0-255.
# Status: black/red/green/yellow/blue/magenta/cyan/white, bright_*, dim, bold.
# Edit and restart ./purp.

[base]
white      = [%d, %d, %d]
title_dark = [%d, %d, %d]

[frame]
border = [%d, %d, %d]

[numbers]
fg = [%d, %d, %d]

[logo]
start = [%d, %d, %d]
end   = [%d, %d, %d]

[title]
start = [%d, %d, %d]
end   = [%d, %d, %d]

[banner]
start = [%d, %d, %d]
mid   = [%d, %d, %d]
end   = [%d, %d, %d]

[hint]
key   = [%d, %d, %d]
label = [%d, %d, %d]
sep   = [%d, %d, %d]

[glow]
tint = %g

[status]
interrupted  = "yellow"
build_failed = "red"
exit_failed  = "red"
success      = "green"
building     = "dim"
`,
		t.White[0], t.White[1], t.White[2],
		t.TitleDark[0], t.TitleDark[1], t.TitleDark[2],
		t.FrameBorder[0], t.FrameBorder[1], t.FrameBorder[2],
		t.NumberColor[0], t.NumberColor[1], t.NumberColor[2],
		t.LogoStart[0], t.LogoStart[1], t.LogoStart[2],
		t.LogoEnd[0], t.LogoEnd[1], t.LogoEnd[2],
		t.TitleStart[0], t.TitleStart[1], t.TitleStart[2],
		t.TitleEnd[0], t.TitleEnd[1], t.TitleEnd[2],
		t.BannerStart[0], t.BannerStart[1], t.BannerStart[2],
		t.BannerMid[0], t.BannerMid[1], t.BannerMid[2],
		t.BannerEnd[0], t.BannerEnd[1], t.BannerEnd[2],
		t.HintKey[0], t.HintKey[1], t.HintKey[2],
		t.HintLabel[0], t.HintLabel[1], t.HintLabel[2],
		t.HintSep[0], t.HintSep[1], t.HintSep[2],
		t.GlowTint,
	)
	return os.WriteFile(path, []byte(body), 0o644)
}

const (
	fps         = 60
	appearDur   = 0.2
	appearLag   = 0.05
	colorDelay  = appearLag + appearDur
	colorDur    = 0.6
	sweepSpread = 0.65
	sweepJitter = 0.07
	glowAmount  = 0.5
	titleText   = "PurpNet!"
	titleDelay  = 0
	titleStep   = 0
	titleFade   = 0.35
	titleMid    = 0.5
	titleGap    = 2

	bgQueryTimeout = 180 * time.Millisecond

	tcsetsf = 0x5404
	tcflsh  = 0x540B

	frameDelay = 1.2
	frameFade  = 0.45
	nameDelay  = 1.55
	nameFade   = 0.35
	nameStep   = 0.04
	colCount   = 3
	colSep     = 3
	namesGap   = 3
	leftPad    = 1
	rightPad   = 1
	selFadeDur = 0.15
)

var (
	logo        = newLogo(" ▐▛██▜▌", "▝▜████▛▘", " ▐▌▐▌▐▌")
	white       = theme.White
	gray        = []RGB{theme.LogoStart, theme.LogoEnd}
	color       = []RGB{theme.TitleStart, theme.TitleEnd}
	frameBorder = theme.FrameBorder
	numberColor = theme.NumberColor
	glow        RGB
	titleDark   = theme.TitleDark
	titleRunes  = []rune(titleText)

	versionText        = loadVersion()
	versionRunes       = []rune(versionText)
	versionNumText     string
	versionStatusText  string
	versionNumRunes    []rune
	versionStatusRunes []rune

	tools       []Tool
	frameBox    FrameBox
	itemsPerCol = 3
	totalItems  = 0

	baseEnd = math.Max(
		colorDelay+sweepSpread+sweepJitter+colorDur,
		math.Max(
			titleDelay+float64(len(titleRunes)-1)*titleStep+titleFade,
			math.Max(
				titleDelay+float64(max(len(versionNumRunes)-1, 0))*titleStep+titleFade,
				titleDelay+float64(max(len(versionStatusRunes)-1, 0))*titleStep+titleFade,
			),
		),
	)

	lin      [256]float64
	out      = os.Stdout
	exitKeys = map[byte]int{3: 130, 4: 0, 28: 131, 'q': 0, 'Q': 0}

	selected  = -1
	selAlpha  []float64
	selTarget []float64

	sysSel       = 0
